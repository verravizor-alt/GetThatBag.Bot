// GetThatBag LLC — OpenClaw Agent Config
// Primary: Groq (free, fast) | Fallback: Gemini Flash | Offline: Ollama
// Channels: Slack + Telegram | Owner: Rian Coleman
{
  // ─── AGENTS ──────────────────────────────────────────────────────────────
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      model: {
        // Groq is primary — free, 500K tokens/day, llama-3.3-70b is best free model
        primary: "groq/llama-3.3-70b-versatile",
        fallbacks: [
          "groq/llama-3.1-8b-instant",
          "gemini/gemini-2.0-flash",
          "gemini/gemini-2.5-flash"
        ],
      },
      models: {
        // Groq models — free tier, 500K tokens/day
        "groq/llama-3.3-70b-versatile": { alias: "Llama70B" },
        "groq/llama-3.1-8b-instant": { alias: "Llama8B" },
        // Gemini models — free tier, 1M tokens/day
        "gemini/gemini-2.0-flash": { alias: "Gemini Flash" },
        "gemini/gemini-2.5-flash": { alias: "Gemini 2.5 Flash" },
      },
      heartbeat: {
        every: "2h",
      },
    },
    list: [
      {
        id: "main",
        name: "GetThatBag Agent",
        description: "24/7 outreach automation agent for GetThatBag LLC local business marketing",
        groupChat: {
          mentionPatterns: ["@getthatbag", "getthatbag", "@agent", "hey agent"],
        },
      },
    ],
  },

  // ─── CHANNELS ────────────────────────────────────────────────────────────
  channels: {
    // Slack — primary command channel
    slack: {
      enabled: true,
      botToken: "${SLACK_BOT_TOKEN}",
      // allowlist: only Rian can DM the bot
      dmPolicy: "allowlist",
      allowFrom: ["${OWNER_SLACK_ID}"],
    },
    // Telegram — mirror + mobile access
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_CHAT_ID}"],
    },
  },

  // ─── GATEWAY ─────────────────────────────────────────────────────────────
  gateway: {
    bind: "lan",
    // Health check endpoints: /healthz and /readyz (no auth required)
    channelHealthCheckMinutes: 5,
    channelStaleEventThresholdMinutes: 30,
    channelMaxRestartsPerHour: 10,
  },

  // ─── SESSION ─────────────────────────────────────────────────────────────
  session: {
    dmScope: "per-channel-peer",
    reset: {
      mode: "daily",
      atHour: 4,
    },
  },

  // ─── MESSAGES ────────────────────────────────────────────────────────────
  messages: {
    visibleReplies: "automatic",
  },
}
